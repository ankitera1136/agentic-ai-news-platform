# API Keys
GROQ_API_KEY=your_groq_api_key_here
GROK_API_KEY=your_grok_api_key_here
XAI_API_KEY=your_xai_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database
DATABASE_URL=sqlite:///./tech_news.db

# Authentication
SECRET_KEY=your_secret_key_for_jwt_tokens_change_this_in_production
ADMIN_EMAIL=your_admin_email@example.com

# CareerRadar
# The flag only controls the automatic scraper hook. The backfill script always runs.
CAREER_RADAR_ENABLED=false
CAREER_EXTRACTION_BATCH_LIMIT=25
CAREER_EXTRACTION_BATCH_LIMIT_VERCEL=3
# Optional Groq model override for CareerRadar only
CAREER_LLM_MODEL=
# Delay between full-body fetches, in seconds
CAREER_FETCH_DELAY_SECONDS=0.5
# Minimum delay between Groq calls during CareerRadar batches, in seconds
CAREER_LLM_CALL_DELAY_SECONDS=1.0

# Email Configuration (for sending digests)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
FROM_EMAIL=your_email@gmail.com
FROM_NAME=Tech News Digest
